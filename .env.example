# SUNROOOF Learning — environment
#
# Local-first: the portal runs with NO environment variables set. Progress is
# stored in ./data/portal.db (SQLite). These vars only turn on optional pieces.

# --- Sequential locking ---
# The day/module/video sequential lock. Default OFF (everything open); progress
# is still recorded. Set to "on" to restore the original sequential locking.
SEQUENTIAL_LOCKING=off

# --- Admin content-coverage page (/admin/coverage) ---
# There is no login yet, so the coverage page is gated by this token: when set,
# open /admin/coverage?token=<value>. If left unset, the page is open in local
# dev and blocked in production.
ADMIN_TOKEN=

# --- AI assistant (§8) ---
# The assistant page works only when this server-side key is set. It is never
# exposed to the browser. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=

# --- Later: Supabase (not required for local-first) ---
# When you move off local SQLite, point these at your Supabase project and swap
# the driver in src/db/index.ts.
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
