# SUNROOOF Learning — environment
#
# Local-first: the portal runs with NO environment variables set. Progress is
# stored in ./data/portal.db (SQLite). These vars only turn on optional pieces.

# --- Sequential locking ---
# The day/module/video sequential lock. Default OFF (everything open); progress
# is still recorded. Set to "on" to restore the original sequential locking.
SEQUENTIAL_LOCKING=off

# --- Admin content-coverage page (/admin/coverage) ---
# There is no login yet, so the coverage page is gated by this token: when set,
# open /admin/coverage?token=<value>. If left unset, the page is open in local
# dev and blocked in production.
ADMIN_TOKEN=

# --- AI assistant + voice (§8, § Voice) ---
# The assistant + voice work only when this server-side key is set. It is never
# exposed to the browser. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the chat model (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=
# Optional: override the API base (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
# Optional voice models — press-to-talk speech-to-text and read-aloud text-to-speech.
# Swap these (and, if needed, the two functions in src/lib/voice.ts) to move to an
# Indian-accent speech model. Defaults: openai/whisper-1 and openai/gpt-4o-mini-tts.
OPENROUTER_TRANSCRIBE_MODEL=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=

# The assistant reads its knowledge base from Supabase using the SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY set above (same private-project credentials as video).

# --- Private video storage (Supabase Storage) ---
# Videos are too big for git and Vercel's filesystem is ephemeral, so on the
# deployed site the real bytes are served from a PRIVATE Supabase bucket. With a
# local mp4 present under media/videos the route streams that instead, so these
# are only needed for the deploy (and to test the storage path locally).
# The service-role key is a SECRET — it is only ever read server-side, never
# committed, and never shipped to the browser.
SUPABASE_URL=https://fcmqpswviaziwrguecgy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=sunrooof-ld-videos

# --- Later: Supabase Postgres (not required for local-first) ---
# When you move off local SQLite, point these at your Supabase project and swap
# the driver in src/db/index.ts.
# DATABASE_URL=
